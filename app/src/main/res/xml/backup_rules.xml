<?xml version="1.0" encoding="utf-8"?>
<!-- SubNexa does not use Android backup (allowBackup=false).
     These rules exclude everything as a second safeguard for API < 31. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
